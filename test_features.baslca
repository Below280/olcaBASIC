REM ══════════════════════════════════════════
REM  olcaBASIC v0.3.0 feature test (FLCAC / USLCI)
REM ══════════════════════════════════════════

CONFIRM DELETE ON

PRINT "=== CLEAN START ==="
REM Remove anything left by a previous run, so everything below
REM is built fresh. Systems first, then the processes they use.
DELETE SYSTEM "Test wall; at site"
DELETE SYSTEM "Test concrete; at plant"
DELETE PROCESS "Test wall; at site"
DELETE PROCESS "Test concrete; at plant"
DELETE SYSTEM "Test pedigree check"
DELETE PROCESS "Test pedigree check"
DELETE PROCESS "Test orphan check"
REM Flows are left in place (olcaBASIC doesn't delete flows); MAKE FLOW
REM reuses a flow with the same name, so repeat runs don't duplicate them

PRINT "=== NAVIGATION ==="
PWD
DIR "31-33: Manufacturing"
CAT
DIR "3273: Cement and Concrete Product Manufacturing"
CAT
UP
PWD
BACK
PWD

PRINT "=== NAVIGATE (separate trees) ==="
NAVIGATE FLOWS
CAT
DIR "Elementary flows"
CAT
NAVIGATE PROCESSES
PWD

PRINT "=== WILDCARDS ==="
CAT *concrete*
CAT PROCESSES *cement*
LS *gravel*

PRINT "=== SEARCH ==="
FIND PROCESS "Portland cement"
FIND PROCESS "ready-mix"
FIND FLOW "Carbon dioxide"
PRINT METHODS
PRINT DQ SYSTEMS

PRINT "=== CONTROL FLOW ==="
FOR i = 1 TO 3
  PRINT "loop", i
NEXT i
FOR EACH m IN 200, 300
  IF m > 250 THEN PRINT m, "is high" ELSE PRINT m, "is low"
NEXT m

PRINT "=== PARAMETERS ==="
LET cement_mass = 300
LET aggregate_ratio = 2.667
LET sand_mass = cement_mass * aggregate_ratio
PRINT "Cement:", cement_mass
PRINT "Sand (derived):", sand_mass

PRINT "=== BUILD ==="
REM Build in our own folder, not inside the database's categories
SET PROCESS FOLDER "00: Test"
SET FLOW FOLDER "00: Test/Flows"
PWD

REM Every background input goes through a bridge (0.4.0)
BRIDGE "Cement", kg
  PROVIDER "Portland cement; at plant"
END BRIDGE
BRIDGE "Sand", kg
  PROVIDER "Construction sand and gravel; at mine"
END BRIDGE

REM cement_mass becomes a global parameter; sand_mass a global
REM formula parameter (cement_mass * aggregate_ratio)
MAKE PROCESS "Test concrete; at plant"
  OUTPUT MAKE FLOW "Test concrete", 1, m3, PRODUCT
  INPUT USE PROCESS "BRIDGE | Cement | kg", cement_mass, kg
  INPUT USE PROCESS "BRIDGE | Sand | kg", sand_mass, kg
  REM Elementary flow: checks the compartment lookup and that it's
  REM characterised (adds 0.3 kg CO2 per m3, i.e. +0.06 in the wall)
  OUTPUT "Carbon dioxide", cement_mass * 0.001, kg TO AIR
END PROCESS

REM A second process that also uses cement_mass, so a scenario
REM has to change it in both places
MAKE PROCESS "Test wall; at site"
  OUTPUT MAKE FLOW "Test wall", 1, m2, PRODUCT
  INPUT USE PROCESS "Test concrete; at plant", 0.2, m3
  INPUT USE PROCESS "BRIDGE | Cement | kg", cement_mass * 0.05, kg
END PROCESS

REM LINK adds sand bedding to the wall after it's built. The amount
REM uses cement_mass, so it must follow the scenarios too.
LINK PROCESS "Construction sand and gravel; at mine" TO PROCESS "Test wall; at site" WITH cement_mass * 0.1, kg

PRINT "=== EDIT ==="
REM Render goes from 0.05 to 0.06 x cement_mass: still proportional,
REM so the scenario ratios must stay exact
EDIT PROCESS "Test wall; at site"
  UPDATE INPUT "BRIDGE | Cement | kg", cement_mass * 0.06, kg
  ADD OUTPUT "Carbon dioxide", 0.5, kg TO AIR
  SET DESCRIPTION "Test wall, edited by olcaBASIC"
END EDIT
REM ...and take the extra CO2 out again, so the ratio check holds
EDIT PROCESS "Test wall; at site"
  REMOVE OUTPUT "Carbon dioxide"
END EDIT

PRINT "=== SHOW ==="
SHOW PROCESS "Test concrete; at plant" INPUTS
SHOW PROCESS "Test wall; at site"
SHOW PARAMETER "sand_mass"

PRINT "=== SYSTEM AND CALCULATE ==="
SYSTEM "Test wall; at site"
CALCULATE "Test wall; at site" USING "IPCC"
SAVE RESULTS "test_baseline.csv"

PRINT "=== TREE ==="
REM Three levels deep, with the background's own pedigree scores
TREE "Test wall; at site" USING "IPCC" CATEGORY "AR6-100" LEVELS 3 TOP 3

PRINT "=== SCENARIOS ==="
REM Everything in the wall scales with cement_mass (cement, derived
REM sand, render, CO2 and the LINKed sand), so Low must be exactly
REM 2/3 of Baseline and High exactly 4/3.
SCENARIO "Baseline"
END SCENARIO

SCENARIO "Low cement"
  LET cement_mass = 200
END SCENARIO

SCENARIO "High cement"
  LET cement_mass = 400
END SCENARIO

RUN SCENARIOS ON "Test wall; at site" USING "IPCC"
SAVE RESULTS "test_scenarios.csv"

PRINT "=== SENSITIVITY ==="
SENSITIVITY ON "Test wall; at site" USING "IPCC" BY 10%
  VARY cement_mass, aggregate_ratio
END SENSITIVITY

PRINT "=== EDIT FLOW ==="
REM Give the concrete a density and make mass its reference. Every
REM exchange keeps its meaning, so the result must not change:
REM AR4-100 should still be 103.947332
SHOW FLOW "Test concrete" UNITS
EDIT FLOW "Test concrete"
  ADD PROPERTY "Mass" AS 2400 kg PER m3
  SET REFERENCE "Mass"
END EDIT
SHOW FLOW "Test concrete" UNITS
CALCULATE "Test wall; at site" USING "IPCC"

PRINT "=== UPDATE PARAMETER ==="
REM Writing cement_mass = 200 straight to the database must give
REM exactly the Low cement scenario result (AR4-100 69.298222)
UPDATE PARAMETER cement_mass = 200
CALCULATE "Test wall; at site" USING "IPCC"
UPDATE PARAMETER cement_mass = 300

PRINT "=== MOVE ==="
MOVE PROCESS "Test wall; at site" TO "00: Test/Moved"
REM Browse to the moved process (browsing doesn't change the build folder)
DIR "00: Test/Moved"
CAT

PRINT "=== CLEANUP ==="
DELETE SYSTEM "Test wall; at site"
DELETE PROCESS "Test wall; at site"
DELETE PROCESS "Test concrete; at plant"

PRINT "=== PEDIGREE ON OUR OWN LINES ==="
REM Uses the first data quality system whose name contains "Flow
REM Pedigree" (PRINT DQ SYSTEMS above lists yours). If yours is named
REM differently, change the FLOW SCHEMA line.
SET PROCESS FOLDER "00: Test"
MAKE PROCESS "Test pedigree check"
  FLOW SCHEMA "Flow Pedigree"
  OUTPUT MAKE FLOW "Test pedigree product", 1, kg, PRODUCT
  INPUT USE PROCESS "BRIDGE | Cement | kg", 10, kg PEDIGREE (1,2,4,1,3) COMMENT "olcaBASIC test comment"
END PROCESS
SHOW PROCESS "Test pedigree check" INPUTS
SYSTEM "Test pedigree check"
TREE "Test pedigree check" USING "IPCC" CATEGORY "AR6-100" LEVELS 2 TOP 3
DELETE SYSTEM "Test pedigree check"
DELETE PROCESS "Test pedigree check"

PRINT "=== DONE ==="
