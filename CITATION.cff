    website: "https://below280.com"
version: 0.4.0
date-released: "2026-11-24"
license: MPL-2.0
repository-code: "https://github.com/Below280/olcaBASIC"
url: "https://pypi.org/project/olcabasic/"
keywords:
  - openLCA
  - life cycle assessment
  - LCA
  - EPD
  - EN 15804
  - BASIC
